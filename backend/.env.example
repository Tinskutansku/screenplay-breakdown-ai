# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# Database (filled in when the database is wired up - see STATUS.md)
DATABASE_URL=postgresql://user:password@localhost:5432/film_ai_breakdown

# JWT signing key for access/refresh tokens. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (see docs/adr/0001-authentication-and-authorization.md).
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
